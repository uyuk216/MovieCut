{
  "name": "yukkuri-editor",
  "version": "0.1.0",
  "description": "VOICEVOX / ゆっくり対応の動画編集ソフト",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dmg --arm64"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.18.0"
  },
  "author": "yukkuri-editor",
  "build": {
    "appId": "jp.local.yukkuri-editor",
    "productName": "ゆっくりエテ\u3099ィタ",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "preview.html",
      "style.css",
      "package.json",
      "LICENSE*.md",
      "docs/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "14.0",
      "category": "public.app-category.video",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "extendInfo": {
        "CFBundleDisplayName": "ゆっくりエディタ"
      }
    },
    "artifactName": "YukkuriEditor-${version}-${arch}.${ext}"
  }
}
